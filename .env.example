AZURE_OPENAI_QUALITY_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
POSTGRES_PASSWORD=
DB_PASSWORD_GATEWAY=
DB_PASSWORD_CATALOG=
DB_PASSWORD_CONTENT=
GATEWAY_ADMIN_TOKEN=
VK_CONTENT_ENGINE=
VK_CATALOG=
CATALOG_TOKEN_ENGINE=
CATALOG_TOKEN_READONLY=
ENGINE_TOKEN_WEB=
ENGINE_TOKEN_EVALS=
